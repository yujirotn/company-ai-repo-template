{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*credentials*)",
      "Read(*secret*)",
      "Read(id_rsa)",
      "Read(id_rsa.*)",
      "Read(id_ed25519)",
      "Read(id_ed25519.*)",
      "Read(.npmrc)",
      "Read(secrets/**)",
      "Read(.aws/**)",
      "Read(.ssh/**)",
      "Bash(rm -rf *)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  }
}
