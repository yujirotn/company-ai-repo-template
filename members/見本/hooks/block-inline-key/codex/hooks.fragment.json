{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/block_inline_key.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
