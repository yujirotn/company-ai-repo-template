# SHO-SAN おすすめの Codex のルール（コマンドの頭の部分で、止める・人に確かめるを決める）
# 1行ずつの説明・外したい時: docs/おすすめの設定.md
# 書き換えた後は Codex を開き直す。確かめ方:
#   codex execpolicy check --pretty --rules .codex/rules/default.rules -- git push origin feature/x

# ── 止める（forbidden） ──
prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "sudo（管理者の権限）は止めています。必要なら本人が自分で実行してください",
    match = ["sudo rm x"],
)
prefix_rule(
    pattern = ["git", "push", ["--force", "-f", "--force-with-lease"]],
    decision = "forbidden",
    justification = "強制 push は履歴を書き換え、元に戻せません",
    match = ["git push --force origin x", "git push -f"],
    not_match = ["git push origin feature/x"],
)
prefix_rule(
    pattern = ["git", "commit", "--no-verify"],
    decision = "forbidden",
    justification = "保存前の確かめを飛ばすのは止めています。落ちた原因を直してください",
)
prefix_rule(
    pattern = [["curl", "wget", "nc", "ncat", "telnet", "scp", "sftp", "ftp"]],
    decision = "forbidden",
    justification = "外へデータを送れるコマンドは止めています。必要なら本人が自分で実行してください",
    match = ["curl https://example.com", "wget x"],
)

# ── 人に確かめる（prompt） ──
prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "GitHub へ送る前に、送り先の枝と中身を確かめてください",
    match = ["git push origin feature/x"],
)
prefix_rule(
    pattern = ["git", ["reset", "clean"]],
    decision = "prompt",
    justification = "手元の変更が消えることがあります。本人がはっきり頼んだ時だけ",
)
prefix_rule(
    pattern = ["rm", ["-r", "-rf", "-fr", "-R", "-Rf"]],
    decision = "prompt",
    justification = "まとめて消す操作です。何が消えるか確かめてください",
    match = ["rm -rf build"],
)
prefix_rule(
    pattern = ["gh", ["pr", "issue", "release", "repo", "gist"], ["create", "merge", "comment", "edit", "delete", "close"]],
    decision = "prompt",
    justification = "GitHub の上で、人の目に触れる操作です。中身を確かめてください",
    match = ["gh pr create --fill"],
    not_match = ["gh pr view 1"],
)
prefix_rule(
    pattern = ["gh", "api"],
    decision = "prompt",
    justification = "gh api は書き込みもできます。中身を確かめてください",
)
prefix_rule(
    pattern = [["vercel", "netlify", "firebase", "terraform", "kubectl", "helm", "pulumi", "wrangler", "fly"]],
    decision = "prompt",
    justification = "本番への反映につながる道具です。行き先を確かめてください",
)
prefix_rule(
    pattern = [["npm", "pnpm", "yarn"], "publish"],
    decision = "prompt",
    justification = "世の中に公開する操作です",
)
prefix_rule(
    pattern = ["supabase", "db", "push"],
    decision = "prompt",
    justification = "データベースの作りを本番に反映する操作です",
)
prefix_rule(
    pattern = [["ssh", "rsync"]],
    decision = "prompt",
    justification = "別のパソコン・サーバーにつなぐ操作です",
)
